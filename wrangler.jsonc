{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "html2pdf",
  "main": "src/index.js",
  "compatibility_date": "2026-04-27",
  "workers_dev": true,
  "compatibility_flags": ["nodejs_compat_v2"],
  "browser": {
    "binding": "MYBROWSER"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
